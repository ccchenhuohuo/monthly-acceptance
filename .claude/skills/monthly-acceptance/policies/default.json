    "automatic_business_closure": false,
    "root_cause_merge_requires_entity_mechanism_proof": true,
    "rule_mode": "shadow_first",
    "budget_exhaustion": "checkpoint_capacity_pending",
    "identity_shard_size": 100,
    "business_classification": {
      "decisions": [
        "investigation_route",
        "report_placement"
      ],
      "reviewed_defer_changes_applicable_denominator": true,
      "automatic_materiality_threshold": null

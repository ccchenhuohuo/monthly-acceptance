  "materiality": {
    "version": "0.0.1",
    "basis": "试运行调查续排容差：对完整可复算总体保留1%量额/SPU观察残余与0.5个百分点价格带残余；未经校准为业务误差许可。缺数据、身份不明、关键冲突、历史具体义务不豁免。",
    "scope": "每义务及同国家同类目同月去重累计；量额正负分别",
    "ratio_tolerance": 0.01,
    "band_pp_tolerance": 0.5,
    "business_release_tolerance": null,
    "unknown_risk": "investigate_or_explicit_external_block",
    "change_control": "new_run_with_frozen_rationale",

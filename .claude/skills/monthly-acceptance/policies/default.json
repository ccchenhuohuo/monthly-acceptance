      "site",
      "month"
    ],
    "history_requires_exact_entities": true
  },
  "review_gate": {
    "enabled": true,
    "independent_for": [
      "high",
      "historical",
      "evidence_conflict",
      "previous_miss"
    ],
    "raw_evidence_and_recalculation_required": true
  },
  "case_workflow": {
    "enabled": true,
    "version": "0.0.1",
    "collection_priority_threshold": 0.02,
